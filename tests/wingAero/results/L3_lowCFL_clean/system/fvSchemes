FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
geometry
{
    type basic;
}

fluxScheme           AUSMPlusUp;
lowMachAusm          false;

ddtSchemes
{
    default          bounded dualTime rPseudoDeltaT steadyState;
}

gradSchemes
{
    default Gauss linear;
    gradTVD          Gauss linear;
    grad(nuTilda) Gauss linear;
}

divSchemes
{
    default          none;

    div(tauMC)       Gauss linear;
    div(phi,nuTilda) bounded Gauss upwind;

    // DAFoam adjoint preconditioner
    div(pc)          bounded Gauss upwind;
}

laplacianSchemes
{
    default                     Gauss linear limited 0.5;
    laplacian(muEff,U)          Gauss linear limited 0.33;
    laplacian(alphaEff,e)       Gauss linear limited 0.33;
}

interpolationSchemes
{
    default          linear;
    reconstruct(rho) wVanLeer;
    reconstruct(U) wVanLeer;
    reconstruct(T) wVanLeer;
}

snGradSchemes
{
    default          limited 0.5;
}

wallDist
{
    method meshWave;
}
// ************************************************************************* //
